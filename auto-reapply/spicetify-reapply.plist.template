<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>__LABEL__</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>__HOME__/.config/spicetify/auto-reapply.sh</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>SPICETIFY</key>
		<string>__SPICETIFY__</string>
	</dict>
	<key>WatchPaths</key>
	<array>
		<string>/Applications/Spotify.app/Contents/Resources/Apps</string>
	</array>
	<key>StartInterval</key>
	<integer>1800</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/spicetify-reapply.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/spicetify-reapply.log</string>
</dict>
</plist>
